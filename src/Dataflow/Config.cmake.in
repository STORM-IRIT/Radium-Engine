# -------------- Configuration of the Radium Dataflow targets and definitions -----------------------
# Setup Dataflow and check for dependencies


# configure Dataflow component
if(NOT TARGET Radium::Dataflow)
    include("${CMAKE_CURRENT_LIST_DIR}/DataflowTargets.cmake")
endif()

if(TARGET Radium::Dataflow)
    set(Radium_Dataflow_FOUND TRUE)
endif()

# Require Core
if(Radium_Dataflow_FOUND)
    add_component_dependency(DataflowCore)
    add_component_dependency(DataflowQtGui)
    # when rendering ready
    #add_component_dependency(DataflowRendenring)
endif()
