# -------------- Configuration of the Radium DataflowCore targets and definitions -----------------------
# Setup Engine and check for dependencies

if (NOT TARGET Radium::DataflowCore)
    # verify dependencies
    include("${CMAKE_CURRENT_LIST_DIR}/DataflowCoreTargets.cmake")
endif()

if(TARGET Radium::DataflowCore)
    set(Radium_DataflowCore_FOUND TRUE)
endif()

# Require Core
if(Radium_DataflowCore_FOUND)
    add_component_dependency(Core)
endif()
